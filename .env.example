# Senha do painel CMS em /admin (obrigatoria em producao, minimo 10 caracteres)
CMS_ADMIN_PASSWORD=

# Segredo da sessao (obrigatorio em producao, minimo 24 caracteres)
CMS_SESSION_SECRET=

# Postgres (OBRIGATORIO na Vercel e no Render em producao)
# Use a URL com pooler do Neon em serverless (ex.: ...-pooler.us-east-2.aws.neon.tech/...)
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
