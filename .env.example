# Host exclusivo do CMS admin (producao)
CMS_ADMIN_HOST=admincms.salgadosborges.com.br

# URL publica do site (links de cardapio /c/slug). Opcional: derivado de admincms.* automaticamente
# PUBLIC_SITE_URL=https://salgadosborges.com.br

# Hosts permitidos em desenvolvimento local (separados por virgula)
CMS_ADMIN_DEV_HOSTS=localhost,127.0.0.1,::1

# Permite /admin no localhost (true = ativo localmente; nao definir no Render/Vercel)
CMS_ADMIN_ALLOW_LOCALHOST=true

# Senha do painel CMS em /admin (obrigatoria em producao, minimo 10 caracteres)
CMS_ADMIN_PASSWORD=

# Segredo da sessao (obrigatorio em producao, minimo 24 caracteres)
CMS_SESSION_SECRET=

# Evolution API — notificacao automatica de pedido (instancia do WhatsApp da loja)
# EVOLUTION_API_URL=https://sua-evolution.com
# EVOLUTION_API_KEY=sua-chave
# EVOLUTION_API_INSTANCE=nome-da-instancia
# Numero que recebe o pedido (padrao: 5517991005213)
# EVOLUTION_ORDER_NOTIFY_NUMBER=5517991005213

# Postgres (OBRIGATORIO na Vercel e no Render em producao)
# Use a URL com pooler do Neon em serverless (ex.: ...-pooler.us-east-2.aws.neon.tech/...)
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
