  "faq": [
    {
      "id": "faq-1",
      "question": "Qual o prazo mínimo de encomenda?",
      "answer": "Trabalhamos com pedidos programados a partir de 48 horas de antecedência. Encomendas maiores exigem uma semana.",
      "visible": true,
      "order": 0
    },
    {
      "id": "faq-2",
      "question": "Quais as formas de pagamento?",
      "answer": "Aceitamos Pix, transferência bancária e cartões via link seguro. Sinal de 30 por cento para reservar a data.",
      "visible": true,
      "order": 1
    },
    {
      "id": "faq-3",
      "question": "Vocês entregam?",
      "answer": "Sim. Entregamos em toda a região com valor de frete calculado por distância. Também oferecemos retirada no ateliê.",
      "visible": true,
      "order": 2
    },
    {
      "id": "faq-4",
      "question": "Posso retirar no local?",
      "answer": "Claro. Retirada disponível de terça a domingo, com horário previamente agendado.",
      "visible": true,
      "order": 3
    },
    {
      "id": "faq-5",
      "question": "Aceitam pedidos sob encomenda?",
      "answer": "Sim. Recheios especiais, restrições alimentares e apresentações temáticas são bem-vindas.",
      "visible": true,
      "order": 4
    },
    {
      "id": "faq-6",
      "question": "Existe quantidade mínima?",
      "answer": "O pedido mínimo é de 100 unidades ou um kit completo, o que for menor no seu caso.",
      "visible": true,
      "order": 5
    }
  ],
